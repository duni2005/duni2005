; Phase 11 file persistence. The web project remains independent.
config_version=5

[application]
config/name="DUNI ARENA — Phase 12"
config/use_custom_user_dir=true
config/custom_user_dir_name="DUNI_ARENA"
run/main_scene="res://scenes/main_menu.tscn"
config/icon="res://assets/ui/app_icon.png"
config/version="0.52.0-preview"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.863, 0.82, 0.953, 1)
boot_splash/stretch_mode=4
boot_splash/use_filter=false
boot_splash/image="res://assets/ui/boot_splash.png"

[autoload]

UiMotionHooks="*res://scripts/presentation/ui_motion_hooks.gd"
MusicPlayer="*res://scripts/presentation/music_player.gd"

[display]
window/size/viewport_width=900
window/size/viewport_height=1000
window/size/window_width_override=720
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[physics]
common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.07, 1)

[editor]

; Binary conversion on export loses UnitData.tags (every unit read as melee on
; device); exported builds keep text resources like the editor.
export/convert_text_resources_to_binary=false

[input_devices]
pointing/emulate_mouse_from_touch=true
