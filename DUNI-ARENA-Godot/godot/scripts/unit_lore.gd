static func attack(type_id: int) -> String:return ATTACK[type_id] if type_id < ATTACK.size() else ""
static func passive(type_id: int) -> String:return PASSIVE[type_id] if type_id < PASSIVE.size() else ""
static func ultimate(type_id: int) -> String:return ULTIMATE[type_id] if type_id < ULTIMATE.size() else ""
